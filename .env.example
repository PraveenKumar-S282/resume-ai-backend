# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# MySQL (see README for local setup)
DATABASE_URL=mysql+pymysql://resume_user:YOUR_PASSWORD@localhost:3306/resume_ai
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookie settings. Use COOKIE_SECURE=true in production (HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Browser origins allowed to call the API (comma separated). Must include the frontend origin.
CORS_ORIGINS=http://localhost:5173

# Gemini (server side only). Get a key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60

RATE_LIMIT_ENABLED=true
